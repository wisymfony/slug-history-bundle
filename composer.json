{
    "name": "wisoft/slug-history-bundle",
    "description": "Automated SEO Management with 301 Redirects",
    "keywords": [
        "seo",
        "redirect",
        "redirects",
        "slug-history",
        "url-redirects",
        "301-redirects",
        "seo-friendly",
        "seo-redirect",
        "slug-management",
        "symfony-bundle",
        "symfony",
        "symfony6",
        "symfony7",
        "symfony8",
        "doctrine",
        "doctrine-orm",
        "url-migration",
        "slug-changes",
        "moved-permanently",
        "url-preservation",
        "cache-storage",
        "database-storage",
        "form-widget",
        "automatic-redirect",
        "route-generation",
        "entity-tracking",
        "old-url-redirect",
        "slug-router",
        "url-mapping",
        "request-listener",
        "slug-tracking",
        "link-management",
        "rest-api"
    ],
    "homepage": "https://github.com/wisymfony/slug-history-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Wisoft\\SlugHistoryBundle\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Wisoft",
            "email": "contact@wi-soft.com"
        },
        {
            "name": "Wisoft",
            "email": "wisoft@outlook.fr"
        },
        {
            "name": "AHOMLANTO David",
            "email": "david@wi-soft.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/routing": "^6.0|^7.0|^8.0",
        "symfony/cache": "^6.0|^7.0|^8.0",
        "symfony/orm-pack": "^2.7"
    },
    "suggest": {
        "symfony/form": "If you want to use SluggedType form widget",
        "symfony/asset": "If you want to use SluggedType form widget assets"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Wisoft\\SlugHistoryBundle\\Tests\\": "tests/"
        }
    },
    "conflict": {}
}
