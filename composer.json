{
    "name": "wisymfony/slug-history-bundle",
    "description": "Automated SEO Management with 301 Redirects",
    "keywords": [
        "slug",
        "seo",
        "redirect",
        "not found"
    ],
    "homepage": "https://github.com/wisymfony/slug-history-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Wisymfony\\SlugHistoryBundle\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Wisoft",
            "email": "contact@wi-soft.com"
        },
        {
            "name": "AHOMLANTO David",
            "email": "david@wi-soft.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/http-foundation": "^6.0|^7.0|^8.0",
        "symfony/routing": "^6.0|^7.0|^8.0",
        "symfony/cache": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/options-resolver": "^6.0|^7.0|^8.0",
        "symfony/asset": "^6.0|^7.0|^8.0",
        "doctrine/orm": "^2.13 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Wisymfony\\SlugHistoryBundle\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/process": ">=6"
    }
}
